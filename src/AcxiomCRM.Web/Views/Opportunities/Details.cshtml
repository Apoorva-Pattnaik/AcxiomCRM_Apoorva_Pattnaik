@model AcxiomCRM.Application.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = Model.OpportunityName;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a asp-action="Index">Opportunities</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.OpportunityName</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h1 class="page-title">@Model.OpportunityName</h1>
            <span class="badge @(Model.Status == AcxiomCRM.Domain.Enums.OpportunityStatus.Won ? "bg-success" : (Model.Status == AcxiomCRM.Domain.Enums.OpportunityStatus.Lost ? "bg-danger" : "bg-primary"))">
                @Model.Status
            </span>
            <span class="badge bg-light text-dark border">@Model.Stage</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this opportunity?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm" title="Deactivate Opportunity">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-briefcase text-primary me-2"></i> Deal Valuation & Status</h6>
            </div>
            <div class="card-body p-3">
                <div class="text-center p-3 bg-light rounded-3 mb-3">
                    <div class="text-muted small text-uppercase fw-bold">Deal Amount</div>
                    <div class="fs-2 fw-bold text-dark">₹@Model.Amount.ToString("N0")</div>
                    <div class="text-muted small mt-1">Weighted: <strong>₹@Model.WeightedValue.ToString("N0")</strong> (@Model.Probability% prob)</div>
                </div>

                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Customer Account</span>
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-decoration-none">
                            @Model.CustomerName
                        </a>
                    </li>
                    @if (Model.LeadId.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Originating Lead</span>
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId.Value" class="text-decoration-none">
                                @Model.LeadName
                            </a>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Pipeline Stage</span>
                        <span class="badge bg-light text-dark border">@Model.Stage</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Expected Close Date</span>
                        <span class="fw-semibold">@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Assigned Sales Executive</span>
                        <span class="badge bg-light text-dark border">@Model.AssignedToUserName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created Date</span>
                        <span>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </li>
                </ul>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="text-muted small fw-bold">Strategy Notes</div>
                        <div class="small text-dark bg-light p-2 rounded mt-1">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- FollowUps -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-warning me-2"></i> Related Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-sm btn-link text-decoration-none">Schedule Follow-Up</a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Subject</th>
                                    <th>Type</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Assigned To</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fu in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="fw-semibold">@fu.Subject</td>
                                        <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                        <td>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-light text-dark border">@fu.Status</span></td>
                                        <td>@fu.AssignedToUserName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No follow-ups recorded for this opportunity yet.</div>
                }
            </div>
        </div>
    </div>
</div>
