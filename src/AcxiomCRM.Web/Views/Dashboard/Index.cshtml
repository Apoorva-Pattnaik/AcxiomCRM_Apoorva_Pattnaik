@model AcxiomCRM.Application.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Executive Dashboard</h1>
        <div class="text-muted small">
            Welcome back, <strong>@Model.UserFullName</strong> &bull; Authorized scope: <span class="badge bg-secondary">@Model.UserRole</span>
        </div>
    </div>

    <!-- Date Filters -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="btn-group shadow-sm" role="group">
            <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
            <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm @(Model.DateFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
            <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm @(Model.DateFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
            <button type="button" class="btn btn-sm @(Model.DateFilter == "Custom" ? "btn-primary" : "btn-outline-secondary")" data-bs-toggle="collapse" data-bs-target="#customFilterPanel">
                <i class="bi bi-calendar-range me-1"></i> Custom
            </button>
        </div>
    </div>
</div>

<!-- Custom Date Filter Collapse -->
<div class="collapse @(Model.DateFilter == "Custom" ? "show" : "") mb-4" id="customFilterPanel">
    <div class="card card-body bg-light border-0 shadow-sm">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <input type="hidden" name="dateFilter" value="Custom" />
            <div class="col-md-4">
                <label class="form-label small fw-bold">Start Date</label>
                <input type="date" name="customStart" class="form-control form-control-sm" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">End Date</label>
                <input type="date" name="customEnd" class="form-control form-control-sm" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Apply Custom Range</button>
                <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- 8 Required KPI Cards -->
<div class="row g-3 mb-4">
    <!-- 1. Total Customers -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Total Customers</div>
                    <div class="kpi-value">@Model.TotalCustomers</div>
                    <div class="kpi-subtext">Active client master records</div>
                </div>
                <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-building fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Total Leads -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Total Leads</div>
                    <div class="kpi-value">@Model.TotalLeads</div>
                    <div class="kpi-subtext">Prospects in funnel</div>
                </div>
                <div class="p-2 bg-info bg-opacity-10 text-info rounded-3">
                    <i class="bi bi-funnel fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Open Leads -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Open Leads</div>
                    <div class="kpi-value">@Model.OpenLeads</div>
                    <div class="kpi-subtext">Excludes converted & lost</div>
                </div>
                <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="bi bi-lightning-charge fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Total Opportunities -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-purple">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Total Opportunities</div>
                    <div class="kpi-value">@Model.TotalOpportunities</div>
                    <div class="kpi-subtext">All pipeline entries</div>
                </div>
                <div class="p-2 bg-purple bg-opacity-10 text-purple rounded-3">
                    <i class="bi bi-briefcase fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Open Opportunities -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Open Opportunities</div>
                    <div class="kpi-value">@Model.OpenOpportunities</div>
                    <div class="kpi-subtext">Active negotiations</div>
                </div>
                <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-arrow-repeat fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Won Opportunities -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Won Opportunities</div>
                    <div class="kpi-value">@Model.WonOpportunities</div>
                    <div class="kpi-subtext">Successfully closed</div>
                </div>
                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-trophy fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. Lost Opportunities -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-danger">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Lost Opportunities</div>
                    <div class="kpi-value">@Model.LostOpportunities</div>
                    <div class="kpi-subtext">Unsuccessful deals</div>
                </div>
                <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3">
                    <i class="bi bi-x-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 8. Total Pipeline Value -->
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Total Pipeline Value</div>
                    <div class="kpi-value text-success">₹@Model.TotalPipelineValue.ToString("N0")</div>
                    <div class="kpi-subtext">Weighted: ₹@Model.WeightedPipelineValue.ToString("N0")</div>
                </div>
                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-currency-rupee fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3 Required Chart.js Visualizations -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status -->
    <div class="col-12 col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5 class="chart-title"><i class="bi bi-pie-chart me-2 text-primary"></i> Lead Status</h5>
                <span class="badge bg-light text-dark border">Funnel</span>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline -->
    <div class="col-12 col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5 class="chart-title"><i class="bi bi-bar-chart-steps me-2 text-warning"></i> Opportunity Pipeline</h5>
                <span class="badge bg-light text-dark border">By Stage</span>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="pipelineChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales -->
    <div class="col-12 col-lg-4">
        <div class="chart-card">
            <div class="chart-header">
                <h5 class="chart-title"><i class="bi bi-graph-up-arrow me-2 text-success"></i> Monthly Sales</h5>
                <span class="badge bg-light text-dark border">Won Revenue</span>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Urgent Follow-ups & Recent Activities Feed -->
<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-alarm text-warning me-2"></i> Action Required: Pending Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UrgentFollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Subject</th>
                                    <th>Related Entity</th>
                                    <th>Due Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fu in Model.UrgentFollowUps)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@fu.Subject</span>
                                            <span class="badge bg-light text-muted border ms-1">@fu.FollowUpType</span>
                                        </td>
                                        <td class="small text-muted">
                                            @(fu.CustomerName ?? fu.LeadName ?? "General")
                                        </td>
                                        <td>
                                            <span class="@(fu.IsOverdue ? "text-danger fw-bold" : "text-dark") small">
                                                @fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")
                                            </span>
                                        </td>
                                        <td>
                                            <form asp-controller="FollowUps" asp-action="Complete" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@fu.FollowUpId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Mark Done">
                                                    <i class="bi bi-check2"></i> Done
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-check-circle fs-2 text-success d-block mb-2"></i>
                        No pending follow-ups in your queue.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-primary me-2"></i> Recent Team Activities</h6>
                <a asp-controller="Activities" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentActivities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var act in Model.RecentActivities)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-primary bg-opacity-10 text-primary me-2">@act.ActivityType</span>
                                        <span class="fw-semibold text-dark">@act.Subject</span>
                                        <span class="text-muted small">&bull; @(act.CustomerName ?? act.LeadName ?? "N/A")</span>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-light text-muted border">@act.AssignedToUserName</span>
                                        <div class="text-muted" style="font-size: 0.75rem;">@act.ActivityDate.ToString("MMM dd, HH:mm")</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        No recent activities recorded yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script>
        var leadData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart));
        var pipelineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityPipelineChart));
        var monthlySalesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesChart));

        document.addEventListener('DOMContentLoaded', function () {
            initDashboardCharts(leadData, pipelineData, monthlySalesData);
        });
    </script>
}
