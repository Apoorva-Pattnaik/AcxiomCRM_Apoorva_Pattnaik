@model List<AcxiomCRM.Domain.Entities.AuditLog>
@{
    ViewData["Title"] = "Security & Audit Logs";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Enterprise Audit & Security Logs</h1>
        <div class="text-muted small">Append-only audit trail capturing logins, failed attempts, modifications, and security state changes (Total: @totalCount)</div>
    </div>
</div>

<!-- Filters -->
<div class="filter-card">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-bold">User / Identity</label>
            <input type="text" name="userId" class="form-control form-control-sm" placeholder="User email or ID..." value="@ViewBag.UserId" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Entity / Module</label>
            <input type="text" name="entityName" class="form-control form-control-sm" placeholder="Customer, Lead, Security..." value="@ViewBag.EntityName" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Action</label>
            <input type="text" name="action" class="form-control form-control-sm" placeholder="Login, Create, Update..." value="@ViewBag.Action" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">From Date</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">To Date</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="crm-table-container">
    <div class="table-responsive">
        <table class="table crm-table align-middle">
            <thead>
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record ID</th>
                    <th>Outcome</th>
                    <th>Activity Details</th>
                    <th>Client IP</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="small font-monospace">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-bold small">@(log.UserName ?? "System")</td>
                            <td>
                                <span class="badge @(log.Action.Contains("Login") ? "bg-info" : (log.Action.Contains("Delete") ? "bg-danger" : "bg-primary"))">
                                    @log.Action
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@log.EntityName</span></td>
                            <td class="small font-monospace text-muted">@(log.RecordId ?? "—")</td>
                            <td>
                                <span class="badge @(log.Result == "Success" ? "bg-success" : "bg-danger")">
                                    @log.Result
                                </span>
                            </td>
                            <td class="small text-truncate" style="max-width: 320px;" title="@log.Details">
                                @(log.Details ?? "—")
                            </td>
                            <td class="small font-monospace text-muted">@log.IpAddress</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No audit trail records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <div class="text-muted small">
                Showing page <strong>@currentPage</strong> of <strong>@totalPages</strong> (Total: @totalCount records)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-userId="@ViewBag.UserId" asp-route-entityName="@ViewBag.EntityName" asp-route-action="@ViewBag.Action">Previous</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-userId="@ViewBag.UserId" asp-route-entityName="@ViewBag.EntityName" asp-route-action="@ViewBag.Action">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-userId="@ViewBag.UserId" asp-route-entityName="@ViewBag.EntityName" asp-route-action="@ViewBag.Action">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
