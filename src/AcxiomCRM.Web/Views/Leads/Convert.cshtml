@model AcxiomCRM.Application.ViewModels.LeadConversionViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.LeadId">@Model.LeadName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Convert</li>
            </ol>
        </nav>
        <h1 class="page-title">Convert Lead to Commercial Account</h1>
        <div class="text-muted small">Lead: <strong>@Model.LeadName</strong> (@Model.LeadCode)</div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="alert alert-info border-0 d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-info-circle-fill fs-4 text-info"></i>
                    <div>
                        Converting a qualified lead automatically transitions its status to <strong>Converted</strong>, preserves all interaction history, and creates persistent Customer and Opportunity records.
                    </div>
                </div>

                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />
                    <input type="hidden" asp-for="CompanyName" />
                    <input type="hidden" asp-for="ExpectedValue" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <!-- Customer Section -->
                    <div class="border rounded-3 p-3 mb-4 bg-light">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="CreateCustomer" class="form-check-input" />
                            <label asp-for="CreateCustomer" class="form-check-label fw-bold text-dark"></label>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="CustomerName" class="form-label small fw-bold"></label>
                                <input asp-for="CustomerName" class="form-control" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Opportunity Section -->
                    <div class="border rounded-3 p-3 mb-4 bg-light">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="CreateOpportunity" class="form-check-input" />
                            <label asp-for="CreateOpportunity" class="form-check-label fw-bold text-dark"></label>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="OpportunityName" class="form-label small fw-bold"></label>
                                <input asp-for="OpportunityName" class="form-control" />
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OpportunityAmount" class="form-label small fw-bold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="OpportunityAmount" class="form-control" type="number" step="1000" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="OpportunityStage" class="form-label small fw-bold"></label>
                                <select asp-for="OpportunityStage" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Enums.OpportunityStage>()"></select>
                                <span asp-validation-for="OpportunityStage" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Probability" class="form-label small fw-bold"></label>
                                <div class="input-group">
                                    <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="Probability" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ExpectedCloseDate" class="form-label small fw-bold"></label>
                                <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="bi bi-arrow-repeat me-1"></i> Finalize Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
