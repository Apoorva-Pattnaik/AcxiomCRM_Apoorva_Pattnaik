@model AcxiomCRM.Application.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Lead Pipeline Management</h1>
        <div class="text-muted small">Capture inquiries, qualify prospects, and convert opportunities</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-funnel me-1"></i> Capture Lead
    </a>
</div>

<!-- Filters -->
<div class="filter-card">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold">Search</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Lead Name, Email, Phone..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Status</label>
            <select name="status" class="form-select form-select-sm" asp-for="StatusFilter" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Enums.LeadStatus>()">
                <option value="">-- All Statuses --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Source</label>
            <input type="text" name="source" class="form-control form-control-sm" placeholder="Website, Referral, Event..." value="@Model.SourceFilter" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Leads Table -->
<div class="crm-table-container">
    <div class="table-responsive">
        <table class="table crm-table align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Contact Info</th>
                    <th>Source</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Status</th>
                    <th>Assigned Rep</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leads.Any())
                {
                    @foreach (var l in Model.Leads)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border font-monospace">@l.LeadCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-bold text-decoration-none">
                                    @l.LeadName
                                </a>
                                @if (!string.IsNullOrEmpty(l.CompanyName))
                                {
                                    <div class="text-muted small">@l.CompanyName</div>
                                }
                            </td>
                            <td>
                                <div class="small">@l.Email</div>
                                <div class="small text-muted">@l.Phone</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                            <td>
                                <span class="badge @(l.Priority == AcxiomCRM.Domain.Enums.LeadPriority.Urgent ? "bg-danger" : (l.Priority == AcxiomCRM.Domain.Enums.LeadPriority.High ? "bg-warning text-dark" : "bg-light text-dark border"))">
                                    @l.Priority
                                </span>
                            </td>
                            <td class="fw-bold text-dark">₹@l.ExpectedValue.ToString("N0")</td>
                            <td>
                                @if (l.Status == AcxiomCRM.Domain.Enums.LeadStatus.Converted)
                                {
                                    <span class="badge-status badge-status-converted"><i class="bi bi-check-all"></i> Converted</span>
                                }
                                else if (l.Status == AcxiomCRM.Domain.Enums.LeadStatus.Qualified)
                                {
                                    <span class="badge-status badge-status-qualified"><i class="bi bi-star-fill"></i> Qualified</span>
                                }
                                else if (l.Status == AcxiomCRM.Domain.Enums.LeadStatus.Contacted)
                                {
                                    <span class="badge-status badge-status-contacted"><i class="bi bi-telephone"></i> Contacted</span>
                                }
                                else if (l.Status == AcxiomCRM.Domain.Enums.LeadStatus.Lost)
                                {
                                    <span class="badge-status badge-status-lost"><i class="bi bi-x-circle"></i> Lost</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status-new"><i class="bi bi-circle"></i> @l.Status</span>
                                }
                            </td>
                            <td class="small">
                                <span class="badge bg-light text-muted border">@l.AssignedToUserName</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit Lead">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (l.Status != AcxiomCRM.Domain.Enums.LeadStatus.Converted)
                                    {
                                        <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer/Opportunity">
                                            <i class="bi bi-arrow-repeat"></i> Convert
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-funnel fs-2 text-muted d-block mb-2"></i>
                            No lead records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <div class="text-muted small">
                Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalItems records)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-source="@Model.SourceFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-source="@Model.SourceFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-source="@Model.SourceFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
