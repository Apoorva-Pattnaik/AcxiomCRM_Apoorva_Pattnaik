@model AcxiomCRM.Application.ViewModels.LeadDetailsViewModel
@{
    ViewData["Title"] = Model.LeadName;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.LeadName</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h1 class="page-title">@Model.LeadName</h1>
            <span class="badge bg-light text-dark border font-monospace">@Model.LeadCode</span>
            <span class="badge @(Model.Status == AcxiomCRM.Domain.Enums.LeadStatus.Converted ? "bg-purple text-white" : "badge-status-new")">@Model.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != AcxiomCRM.Domain.Enums.LeadStatus.Converted)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert Lead
            </a>
            <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
            </a>
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.LeadId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this lead record?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Deactivate Lead">
                    <i class="bi bi-trash"></i>
                </button>
            </form>
        }
        else
        {
            @if (Model.ConvertedCustomerId.HasValue)
            {
                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId.Value" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-building me-1"></i> View Converted Customer
                </a>
            }
            @if (Model.ConvertedOpportunityId.HasValue)
            {
                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.ConvertedOpportunityId.Value" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-briefcase me-1"></i> View Converted Opportunity
                </a>
            }
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel text-primary me-2"></i> Lead Details</h6>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email</span>
                        <span class="fw-bold text-dark">@Model.Email</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Phone</span>
                        <span class="fw-bold text-dark">@Model.Phone</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Company</span>
                        <span class="fw-semibold">@(Model.CompanyName ?? "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Source</span>
                        <span class="badge bg-light text-dark border">@Model.Source</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Priority</span>
                        <span class="badge bg-light text-dark border">@Model.Priority</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Expected Value</span>
                        <span class="fw-bold text-success">₹@Model.ExpectedValue.ToString("N0")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Assigned To</span>
                        <span class="badge bg-light text-dark border">@Model.AssignedToUserName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created</span>
                        <span>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </li>
                    @if (Model.ConvertedDate.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Converted On</span>
                            <span class="text-success fw-bold">@Model.ConvertedDate.Value.ToString("yyyy-MM-dd")</span>
                        </li>
                    }
                </ul>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="text-muted small fw-bold">Prospect Notes</div>
                        <div class="small text-dark bg-light p-2 rounded mt-1">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- FollowUps -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-warning me-2"></i> Follow-Up Activities (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">Schedule Follow-Up</a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Subject</th>
                                    <th>Type</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Assigned To</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fu in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="fw-semibold">@fu.Subject</td>
                                        <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                        <td>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-light text-dark border">@fu.Status</span></td>
                                        <td>@fu.AssignedToUserName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No scheduled follow-ups for this lead.</div>
                }
            </div>
        </div>

        <!-- Activities -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-info me-2"></i> Logged Activities (@Model.Activities.Count)</h6>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none">Log Activity</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Activities.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var act in Model.Activities)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-light text-dark border me-2">@act.ActivityType</span>
                                        <strong class="text-dark">@act.Subject</strong>
                                        @if (!string.IsNullOrWhiteSpace(act.Description))
                                        {
                                            <div class="text-muted mt-1">@act.Description</div>
                                        }
                                    </div>
                                    <div class="text-end text-muted">
                                        <div>@act.AssignedToUserName</div>
                                        <div>@act.ActivityDate.ToString("yyyy-MM-dd HH:mm")</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No activities logged for this lead yet.</div>
                }
            </div>
        </div>
    </div>
</div>
