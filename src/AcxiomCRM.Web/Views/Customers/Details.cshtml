@model AcxiomCRM.Application.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = Model.CustomerName;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.CustomerName</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h1 class="page-title">@Model.CustomerName</h1>
            <span class="badge bg-light text-dark border font-monospace">@Model.CustomerCode</span>
            <span class="badge-status badge-status-active">@Model.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-briefcase me-1"></i> New Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this customer? All historical records will be preserved.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm" title="Deactivate Customer">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Customer Profile Info -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-person-vcard text-primary me-2"></i> Profile Overview</h6>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email</span>
                        <span class="fw-bold text-dark">@Model.Email</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Phone</span>
                        <span class="fw-bold text-dark">@Model.Phone</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Company</span>
                        <span class="fw-semibold">@(Model.CompanyName ?? "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Location</span>
                        <span>@(string.IsNullOrEmpty(Model.City) ? "—" : $"{Model.City}, {Model.State}")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Assigned Rep</span>
                        <span class="badge bg-light text-dark border">@Model.AssignedToUserName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created Date</span>
                        <span>@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created By</span>
                        <span>@(Model.CreatedBy ?? "System")</span>
                    </li>
                </ul>

                @if (!string.IsNullOrWhiteSpace(Model.Address))
                {
                    <div class="mt-3">
                        <div class="text-muted small fw-bold">Street Address</div>
                        <div class="small text-dark">@Model.Address</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="text-muted small fw-bold">Executive Notes</div>
                        <div class="small text-dark bg-light p-2 rounded mt-1">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Related Deals, Follow-ups, Activities -->
    <div class="col-lg-8">
        <!-- Opportunities -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-briefcase text-primary me-2"></i> Commercial Opportunities (@Model.Opportunities.Count)</h6>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-link text-decoration-none">Add Opportunity</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Opportunities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Deal Name</th>
                                    <th>Amount</th>
                                    <th>Stage</th>
                                    <th>Prob %</th>
                                    <th>Close Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-decoration-none">
                                                @opp.OpportunityName
                                            </a>
                                        </td>
                                        <td class="fw-bold">₹@opp.Amount.ToString("N0")</td>
                                        <td><span class="badge bg-light text-dark border">@opp.Stage</span></td>
                                        <td>@opp.Probability%</td>
                                        <td>@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <span class="badge @(opp.Status == AcxiomCRM.Domain.Enums.OpportunityStatus.Won ? "bg-success" : (opp.Status == AcxiomCRM.Domain.Enums.OpportunityStatus.Lost ? "bg-danger" : "bg-primary"))">
                                                @opp.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No commercial opportunities linked to this customer yet.</div>
                }
            </div>
        </div>

        <!-- Follow-ups -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-warning me-2"></i> Scheduled Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-link text-decoration-none">Schedule Follow-Up</a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Subject</th>
                                    <th>Type</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Assigned To</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fu in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="fw-semibold">@fu.Subject</td>
                                        <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                        <td>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <span class="badge @(fu.Status == AcxiomCRM.Domain.Enums.FollowUpStatus.Completed ? "bg-success" : (fu.Status == AcxiomCRM.Domain.Enums.FollowUpStatus.Planned ? "bg-primary" : "bg-secondary"))">
                                                @fu.Status
                                            </span>
                                        </td>
                                        <td>@fu.AssignedToUserName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No scheduled follow-ups found.</div>
                }
            </div>
        </div>

        <!-- Activities History -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-info me-2"></i> Activity Log (@Model.Activities.Count)</h6>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-link text-decoration-none">Log Activity</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Activities.Any())
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var act in Model.Activities)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-light text-dark border me-2">@act.ActivityType</span>
                                        <strong class="text-dark">@act.Subject</strong>
                                        @if (!string.IsNullOrWhiteSpace(act.Description))
                                        {
                                            <div class="text-muted mt-1">@act.Description</div>
                                        }
                                    </div>
                                    <div class="text-end text-muted">
                                        <div>@act.AssignedToUserName</div>
                                        <div>@act.ActivityDate.ToString("yyyy-MM-dd HH:mm")</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No activities logged yet.</div>
                }
            </div>
        </div>
    </div>
</div>
