@model AcxiomCRM.Application.ViewModels.CustomerListViewModel
@{
    ViewData["Title"] = "Customer Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Customer Master Directory</h1>
        <div class="text-muted small">Manage client relationships, contact profiles, and commercial accounts</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Add Customer
    </a>
</div>

<!-- Filter Bar -->
<div class="filter-card">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-bold">Search</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Name, Email, Phone, Company..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Status</label>
            <select name="status" class="form-select form-select-sm" asp-for="StatusFilter" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Enums.CustomerStatus>()">
                <option value="">-- All Statuses --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">City</label>
            <input type="text" name="city" class="form-control form-control-sm" placeholder="Filter by city..." value="@Model.CityFilter" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Customers Table -->
<div class="crm-table-container">
    <div class="table-responsive">
        <table class="table crm-table align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Email & Phone</th>
                    <th>Company</th>
                    <th>City / State</th>
                    <th>Status</th>
                    <th>Assigned Executive</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Any())
                {
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@c.CustomerCode</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-bold text-decoration-none">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td>
                                <div class="small text-dark">@c.Email</div>
                                <div class="small text-muted">@c.Phone</div>
                            </td>
                            <td class="text-muted small">@(c.CompanyName ?? "—")</td>
                            <td class="text-muted small">
                                @(string.IsNullOrEmpty(c.City) ? "—" : $"{c.City}, {c.State}")
                            </td>
                            <td>
                                <span class="badge-status badge-status-active">
                                    <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> @c.Status
                                </span>
                            </td>
                            <td class="small">
                                <span class="badge bg-light text-muted border">@c.AssignedToUserName</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary" title="Edit Customer">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 text-muted d-block mb-2"></i>
                            No customer records match your filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <div class="text-muted small">
                Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalItems records)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-city="@Model.CityFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-city="@Model.CityFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-city="@Model.CityFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
