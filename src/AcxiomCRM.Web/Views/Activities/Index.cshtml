@model AcxiomCRM.Application.ViewModels.ActivityListViewModel
@{
    ViewData["Title"] = "Activity Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Activity Management</h1>
        <div class="text-muted small">Track and log customer interactions, calls, meetings, emails, and tasks</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Log Activity
    </a>
</div>

<!-- Filters -->
<div class="filter-card">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold">Search</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Subject, description..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Type</label>
            <select name="type" class="form-select form-select-sm" asp-for="TypeFilter" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Enums.ActivityType>()">
                <option value="">-- All Types --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">Status</label>
            <select name="status" class="form-select form-select-sm" asp-for="StatusFilter" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Enums.ActivityStatus>()">
                <option value="">-- All Statuses --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Date</label>
            <input type="date" name="date" class="form-control form-control-sm" value="@(Model.DateFilter?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="crm-table-container">
    <div class="table-responsive">
        <table class="table crm-table align-middle">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Activity Date</th>
                    <th>Status</th>
                    <th>Logged By</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activities.Any())
                {
                    @foreach (var act in Model.Activities)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary border">@act.ActivityType</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@act.Subject</div>
                                @if (!string.IsNullOrWhiteSpace(act.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 250px;">@act.Description</div>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(act.CustomerName))
                                {
                                    <div><i class="bi bi-building text-muted me-1"></i> @act.CustomerName</div>
                                }
                                else if (!string.IsNullOrEmpty(act.LeadName))
                                {
                                    <div><i class="bi bi-funnel text-muted me-1"></i> @act.LeadName</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="small">@act.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge @(act.Status == AcxiomCRM.Domain.Enums.ActivityStatus.Completed ? "bg-success" : (act.Status == AcxiomCRM.Domain.Enums.ActivityStatus.Cancelled ? "bg-secondary" : "bg-warning text-dark"))">
                                    @act.Status
                                </span>
                            </td>
                            <td class="small"><span class="badge bg-light text-muted border">@act.AssignedToUserName</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@act.ActivityId" class="btn btn-outline-primary" title="Edit Activity">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@act.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity entry?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-clock-history fs-2 text-muted d-block mb-2"></i>
                            No activity records found matching criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <div class="text-muted small">
                Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (Total: @Model.TotalItems records)
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
