@{
    ViewData["Title"] = "CRM Analytics & Reports";
    var userRole = ViewBag.UserRole as string ?? AcxiomCRM.Domain.Enums.AppRoles.SalesExecutive;
    var isAdmin = userRole == AcxiomCRM.Domain.Enums.AppRoles.Admin;
    var isManagerOrAdmin = isAdmin || userRole == AcxiomCRM.Domain.Enums.AppRoles.Manager;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Analytics & Intelligence Reports</h1>
        <div class="text-muted small">Standard business performance reports filtered strictly according to your security scope (@userRole)</div>
    </div>
</div>

<div class="row g-4">
    <!-- Customer Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
            <div class="card-body">
                <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3 d-inline-block mb-3">
                    <i class="bi bi-people fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Customer Directory Report</h5>
                <p class="text-muted small">Comprehensive breakdown of active accounts, geographic presence, assigned executives, and commercial deal history.</p>
                <a asp-action="CustomerReport" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                    View Customer Report <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Lead Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
            <div class="card-body">
                <div class="p-2 bg-info bg-opacity-10 text-info rounded-3 d-inline-block mb-3">
                    <i class="bi bi-funnel fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Lead Source & Funnel Report</h5>
                <p class="text-muted small">Lead intake velocity, conversion status tracking, expected value distributions, and channel effectiveness.</p>
                <a asp-action="LeadReport" class="btn btn-outline-info btn-sm w-100 fw-bold">
                    View Lead Report <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Opportunity Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
            <div class="card-body">
                <div class="p-2 bg-purple bg-opacity-10 text-purple rounded-3 d-inline-block mb-3">
                    <i class="bi bi-briefcase fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Opportunity Stage Report</h5>
                <p class="text-muted small">Individual commercial opportunities, win probabilities, expected close dates, and contract valuations.</p>
                <a asp-action="OpportunityReport" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                    View Opportunity Report <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Pipeline Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
            <div class="card-body">
                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3 d-inline-block mb-3">
                    <i class="bi bi-bar-chart-steps fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Sales Pipeline Report</h5>
                <p class="text-muted small">Aggregated stage-wise and owner-wise pipeline valuation, weighted revenue forecast, and deal volume.</p>
                <a asp-action="PipelineReport" class="btn btn-outline-success btn-sm w-100 fw-bold">
                    View Pipeline Report <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Follow-Up Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
            <div class="card-body">
                <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3 d-inline-block mb-3">
                    <i class="bi bi-calendar-check fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Follow-Up Compliance Report</h5>
                <p class="text-muted small">Scheduled engagement adherence, completed interactions, overdue tasks, and task disposition summaries.</p>
                <a asp-action="FollowUpReport" class="btn btn-outline-warning btn-sm w-100 fw-bold">
                    View Follow-Up Report <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Sales & Conversion Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
            <div class="card-body">
                <div class="p-2 bg-dark bg-opacity-10 text-dark rounded-3 d-inline-block mb-3">
                    <i class="bi bi-percent fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark">Sales & Conversion Report</h5>
                <p class="text-muted small">Conversion ratios from prospective leads to customers, win/loss percentages, and total won contract revenue.</p>
                <a asp-action="ConversionReport" class="btn btn-outline-dark btn-sm w-100 fw-bold">
                    View Conversion Report <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    @if (isManagerOrAdmin)
    {
        <!-- User Activity Report -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 border-start border-4 border-info">
                <div class="card-body">
                    <div class="p-2 bg-info bg-opacity-10 text-info rounded-3 d-inline-block mb-3">
                        <i class="bi bi-person-lines-fill fs-3"></i>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="fw-bold text-dark mb-0">User Activity Report</h5>
                        <span class="badge bg-info">Manager / Admin</span>
                    </div>
                    <p class="text-muted small">Executive action counts: logged calls, client meetings, customer emails, and completed tasks across all team members.</p>
                    <a asp-action="UserActivityReport" class="btn btn-info text-white btn-sm w-100 fw-bold">
                        View User Activity Report <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }

    @if (isAdmin)
    {
        <!-- Audit Report -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-3 border-start border-4 border-danger">
                <div class="card-body">
                    <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3 d-inline-block mb-3">
                        <i class="bi bi-journal-shield fs-3"></i>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="fw-bold text-dark mb-0">Security & Audit Report</h5>
                        <span class="badge bg-danger">Admin Only</span>
                    </div>
                    <p class="text-muted small">System security events, user logins, failed attempts, account lockouts, record modifications, and privilege escalations.</p>
                    <a asp-action="AuditReport" class="btn btn-danger btn-sm w-100 fw-bold">
                        View Audit Report <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
