@model AcxiomCRM.Application.ViewModels.FollowUpCreateEditViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a asp-action="Index">Follow-Ups</a></li>
                <li class="breadcrumb-item active" aria-current="page">Schedule</li>
            </ol>
        </nav>
        <h1 class="page-title">Schedule Follow-Up Engagement</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Subject" class="form-label small fw-bold"></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Contract Clarification Call" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FollowUpType" class="form-label small fw-bold"></label>
                            <select asp-for="FollowUpType" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Enums.FollowUpType>()"></select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FollowUpDate" class="form-label small fw-bold"></label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" value="@Model.FollowUpDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label small fw-bold"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Domain.Enums.FollowUpStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CustomerId" class="form-label small fw-bold"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- Customer (Optional) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LeadId" class="form-label small fw-bold"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">-- Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="OpportunityId" class="form-label small fw-bold"></label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.Opportunities">
                                <option value="">-- Opportunity (Optional) --</option>
                            </select>
                            <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole(AcxiomCRM.Domain.Enums.AppRoles.Admin) || User.IsInRole(AcxiomCRM.Domain.Enums.AppRoles.Manager))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedToUserId" class="form-label small fw-bold"></label>
                                <select asp-for="AssignedToUserId" class="form-select" asp-items="ViewBag.Executives">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label small fw-bold"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Objective, talking points, preparation notes..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-calendar-check me-1"></i> Save Schedule
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
