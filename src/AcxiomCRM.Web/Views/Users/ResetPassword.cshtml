@model AcxiomCRM.Application.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Admin Password Reset";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom">
                <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                <li class="breadcrumb-item active" aria-current="page">Reset Password</li>
            </ol>
        </nav>
        <h1 class="page-title">Administrator Password Reset</h1>
        <div class="text-muted small">Setting new credentials for: <strong>@Model.FullName</strong> (@Model.Email)</div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="alert alert-warning border-0 small d-flex gap-2 align-items-center mb-4">
                    <i class="bi bi-shield-exclamation fs-4 text-warning"></i>
                    <div>
                        Resetting the password will clear any existing account lockout and unlock the account automatically. Passwords must comply with policy rules.
                    </div>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-bold"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Min. 8 characters with mix of cases & symbols" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Re-enter password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning fw-bold px-4">
                            <i class="bi bi-key-fill me-1"></i> Apply New Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
